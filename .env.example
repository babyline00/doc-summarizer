# Absolute SQLite path — used by Prisma at runtime (next dev / next start).
# The db:* npm scripts inline DATABASE_URL="$(pwd)/db/custom.db" so prisma CLI
# works without .env being loaded.
DATABASE_URL=file:/home/z/my-project/apps/40-doc-summarizer/db/custom.db

# --- Optional LLM / embeddings providers ---
# When unset, the app uses the built-in hashing embedder + the z-ai-web-dev-sdk
# default chat model. Set these to plug in OpenAI-compatible endpoints.

# OpenAI-compatible chat (used by z-ai-web-dev-sdk when configured)
# ZAI_API_KEY=
# ZAI_BASE_URL=

# OpenAI-compatible embeddings (optional — falls back to hashing embedder)
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# Disable the live LLM and force the deterministic MockProvider (testing / demo)
# PKC_DISABLE_LLM=1
